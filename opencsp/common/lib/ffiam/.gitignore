*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects
*.dll
!pyffiam/src/pyffiam/external/ffiam_lib.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app

# Debug symbols
*.pdb
*.ilk

# CUDA specific
*.cubin
*.fatbin
*.ptx
*.gpu
*.i
*.ii

